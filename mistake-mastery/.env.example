# 复制成 .env 后填写。.env 里有密钥，已被 .gitignore 排除，不要提交到任何仓库。

# 私有数据仓库的本地克隆（孩子的数据只放这里）
XT_DATA_DIR=/Users/你的用户名/xuetou-data

# 家庭密码：二选一。推荐用哈希（uv run python -m app.tools.hash_password 生成）
XT_FAMILY_PASSWORD=
XT_FAMILY_PASSWORD_HASH=

# 大模型（OpenAI 兼容协议）：至少填一家。通义千问填 XT_DASHSCOPE_API_KEY，小米 MiMo 填 XT_MIMO_API_KEY。
# 只填一家就自动用那一家。两家都填了默认用通义千问，想用 MiMo 就去掉下面 XT_MODEL_PRESET 前面的 #
XT_DASHSCOPE_API_KEY=
XT_MIMO_API_KEY=
# XT_MODEL_PRESET=mimo
# 小米 MiMo 的接口地址，默认是 Token Plan 中国区；按量付费的账号改成控制台给的地址
# XT_MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
# 交叉校验（v0.2）还需要另一家，比如豆包
XT_ARK_API_KEY=
XT_DEEPSEEK_API_KEY=

# 去手写：local_color（本地，只擦彩色笔迹）| baidu | youdao | textin | none
XT_ERASER=local_color
XT_BAIDU_API_KEY=
XT_BAIDU_SECRET_KEY=
XT_YOUDAO_APP_KEY=
XT_YOUDAO_APP_SECRET=
XT_TEXTIN_APP_ID=
XT_TEXTIN_SECRET_CODE=
# 接口地址以各家控制台文档为准，不对时在这里覆盖
# XT_BAIDU_ERASE_URL=
# XT_YOUDAO_ERASE_URL=
# XT_TEXTIN_ERASE_URL=

# 每天 AI 费用上限（元）
XT_DAILY_COST_CAP_CNY=5

# 送给外部接口前把第 1 页卷头涂白的比例（0 = 不涂；可以试 0.08）
XT_MASK_HEADER_RATIO=0

# 改动后多少秒自动同步到 GitHub
XT_SYNC_DEBOUNCE_SECONDS=120

# 生成 PDF 用的 Chromium；留空则使用 `uv run playwright install chromium` 安装的
XT_CHROMIUM_PATH=
